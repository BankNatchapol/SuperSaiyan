
# gstack local state
.gstack/

# Board configs created by supersaiyan setup (contain personal GH project info)
.claude/super-board/

# Per-machine runtime state from supersaiyan setup/run — configs/*.json is committed,
# these are not (stale from pre-rebrand .claude/super-board/ above, paths moved 2026-06-20)
.claude/supersaiyan/active
.claude/supersaiyan/inflight/

# Same as above, at the vendor-neutral root — new onboards write here; the two rules above
# stay in place so pre-existing installs still under .claude/ keep working (paths moved again,
# this time out from under .claude/, 2026-08-10)
.supersaiyan/active
.supersaiyan/inflight/

# Derived state: super-board-run.sh writes the resolved view of an `extends`-linked config
# here so workers get a stable path (see scripts/config-resolve.sh). Regenerated every run
# from the committed configs/*.json, so it is machine-local, never a source of truth.
.supersaiyan/resolved/
.claude/supersaiyan/resolved/

# Absolute-path symlink — only valid on the original machine
.claude/skills/gstack

# Codex machine-local instruction override — layered on top of AGENTS.md, per-machine
AGENTS.override.md

# Runtime state generated by prepare.sh
*.issue-map.json

# Optional Control Center build output
node_modules/
apps/desktop/.vite/
apps/desktop/out/
apps/desktop/test-results/
*.tsbuildinfo
__pycache__/
*.pyc

# Local source archive; the extracted design reference is kept under design/
Dashboard Design.zip

# macOS / editor junk
.DS_Store
Thumbs.db
.idea/
*.swp
