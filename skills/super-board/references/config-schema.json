// Source of truth: docs/superpowers/specs/2026-05-21-super-board-design.md §4
//
// This file is a REFERENCE DOC, not parsed by the skill at runtime. It uses
// JSON5-style `//` line comments to inline field notes from spec §4 alongside
// the schema. Strip comments before validating an actual config file as JSON.
//
// One config per GitHub project this repo drives, written to
// `.supersaiyan/configs/<slug>.json` (committed). The active
// pointer `.supersaiyan/active` is gitignored and per-machine. Vendor-neutral root —
// `.claude/supersaiyan/configs/` and `.claude/super-board/configs/` are legacy roots still
// read via fallback for installs from before this path moved; new onboards write only to
// `.supersaiyan/`. See scripts/config-resolve.sh and scripts/super-board-status.py's
// config_roots().

{
  "version": 1,

  // Short scannable label shown when multiple configs are listed.
  // E.g. "staging QA" or "admin build pipeline".
  "description": "<short scannable label, e.g. 'staging QA' or 'admin build pipeline'>",

  // Optional. A slug (no ".json") naming ANOTHER config file in this same `configs/`
  // directory to inherit shared fields from. Every consumer resolves this once, before
  // reading any other field: the base config's fields are the defaults, this file's own
  // fields win per-key (nested objects merge recursively — e.g. this file can set just
  // `notifications.channel` and still inherit the base's `notifications.bot_identity`).
  // `extends` itself is stripped after resolution.
  //
  // Built for the "independent boards" multi-tool pattern in references/onboard.md step
  // 2: instead of N fully duplicated config files (one per tool, ~15 shared fields
  // copy-pasted N times), write ONE base config with the shared settings, and N thin
  // overlays that set only `description`, `worker_backend`, and their own model block:
  //   myboard.json          — base: project, variant, base_branch, columns, paths,
  //                            human_approves_merge, truth_gate, rebuild_cap, ...
  //   myboard-codex.json    — { "extends": "myboard", "worker_backend": "codex-exec",
  //                             "codex": { "model": "gpt-5.6-sol" } }
  //
  // Constraints: the base config must NOT itself set `extends` (no chains — resolution
  // errors clearly if it does). Absent/null (the common case) costs nothing extra.
  //
  // Where the resolved view lands: `super-board-run.sh` writes it to
  // `<config-root>/resolved/<slug>.json` and hands THAT path to workers, because a worker
  // can outlive the dispatcher that spawned it and must not be pointed at a temp file the
  // dispatcher deletes on exit. That directory is machine-local (gitignored) and rewritten
  // every run — the committed `configs/*.json` stay the only source of truth. It is
  // deliberately outside `configs/`, which every consumer globs to enumerate boards.
  "extends": null,

  "project": {
    "owner": "<github-owner>",
    "title": "<project title on GitHub>",
    // Required; `gh project` CLI takes number, not title (titles aren't unique).
    "number": 0
  },

  // "full" or "qa-only".
  "variant": "qa-only",

  // Worker dispatch backend. "workflow" (default) drains waves in-session via
  // the super-board-wave dynamic workflow (references/run-workflow.md);
  // Claude-Code-only — requires dynamic workflows enabled in /config. The
  // remaining three values share one headless bash dispatcher
  // (.supersaiyan/bin/super-board-run.sh) via scripts/backends/<name>.sh — see
  // references/backends.md for the full contract and per-tool setup:
  //   "claude-p"      — legacy, spawns `claude -p` workers.
  //   "codex-exec"    — spawns `codex exec` workers.
  //   "cursor-agent"  — spawns `agent -p` (Cursor CLI) workers.
  // All three are explicit opt-in; the dispatcher refuses to run (exit 78)
  // unless one of them is set here.
  //
  // ALTERNATIVE SHAPE — per-lane object. Static (picked once per run, not
  // adaptive), it drives ONE board with a different bash-dispatcher backend
  // per lane — e.g. Codex builds, Cursor QAs, Claude reviews:
  //   "worker_backend": {
  //     "build":  "codex-exec",
  //     "qa":     "cursor-agent",
  //     "review": "claude-p"
  //   }
  // Any lane key you omit defaults to "claude-p". "workflow" is never valid
  // as a per-lane value — it is Claude-Code-session-bound, not a
  // bash-dispatcher backend. A qa-only board never dispatches a build lane,
  // so a "build" key is accepted but ignored under that variant. This is
  // still ONE dispatcher process for the whole config; for genuinely
  // independent parallel boards (one tool = one full separate run), use the
  // N-separate-configs path in references/onboard.md step 2 instead.
  "worker_backend": "workflow",

  // Per-tool model overrides for the bash-dispatcher backends. Applied
  // wherever that TOOL is used across the run — one setting per TOOL, not
  // per lane x tool, so picking "codex-exec" for two lanes does not mean
  // configuring the model twice. Empty string = use the CLI's own default.
  // `reasoning_effort` is passed through as a free-form string; accepted
  // values are model-specific and are not validated here. Both blocks are
  // ignored entirely when no lane resolves to that tool. Env vars
  // CODEX_MODEL / CODEX_REASONING_EFFORT / CURSOR_MODEL override these for
  // a single run. claude-p has no model field by design — it inherits the
  // session model, same as the workflow backend's Reviewer lane.
  "codex": {
    "model": "",
    "reasoning_effort": ""
  },
  "cursor": {
    "model": ""
  },

  // Which forge this config drives. "github" (default, back-compat) or "gitlab".
  // Orthogonal to worker_backend — any combination is valid. Selects which
  // scripts/platforms/<name>.sh the dispatcher sources. See references/platforms.md.
  "git_platform": "github",

  // Default model ladder for lane workers, indexed by card complexity from
  // the classify router. Overridden per run by `super-board run --low|--high`.
  //   "low"    — haiku (low) / sonnet (medium) / opus (high)
  //   "medium" — (default) sonnet / opus / session model
  //   "high"   — opus floor; medium+ inherit the session model
  "model_tier": "medium",

  "target": {
    // "url" | "repo" | "repo+url". Tells the runner whether to clone, hit a
    // URL, or both.
    "type": "url",
    "url": "<https://your-target-url.example.com>"
  },

  // `null` for URL-only; `{path, remote}` otherwise. `remote` can be `null`
  // for local-only.
  "repo": null,

  // The branch all per-issue branches are cut from and squash-merged back into.
  // Default `"main"`. Onboard warns and suggests `"staging"` or `"develop"` if
  // `main` appears to be production.
  "base_branch": "main",

  // Names of the Status options on the project. Aliases tolerated;
  // canonicalized at read time.
  //
  // Full variant (7):    Ready · Building · QA · Review · Done · Blocked · Skipped
  // QA-only variant (6): Ready ·            QA · Review · Done · Blocked · Skipped
  "columns": ["Ready", "QA", "Review", "Done", "Blocked", "Skipped"],

  "paths": {
    // `null` when no PROJECT.md exists (URL-only flows).
    "project_md": null,
    "pre_flight_md": "docs/supersaiyan/pre-flight.md",
    "runs_dir": "docs/supersaiyan/runs"
  },

  // When `true`, Reviewer marks the PR ready but does NOT squash-merge; a
  // human must click merge. Card auto-moves to Done when the PR is merged
  // externally. Default `false`. Onboard FORCES this to `true` when
  // `base_branch` is `main` AND the repo has a deploy workflow detected.
  "human_approves_merge": false,

  // Controls Reviewer's adversarial mode (folded-in super-truth pattern).
  //   "off"          — never adversarial.
  //   "non-trivial"  — (default) activates on cards with diff ≥10 lines OR
  //                    labels in {security, migration, payments, auth}.
  //   "always"       — every card gets adversarial review
  //                    (cost: 2 sub-agent dispatches per card).
  "truth_gate": "non-trivial",

  // Minimum aggregated sub-agent confidence (0-100) required to approve.
  // Default `70`. Below threshold, Reviewer must NOT approve; card moves to
  // Blocked with `🛡 truth-check failed (confidence X/100)`. See §7.
  "truth_threshold": 70,

  // Max consecutive failures in the same lane on the same root-cause hash
  // before the card auto-moves to Blocked. Default `2`. Root-cause hash
  // defined in §7 Halt gates. Resets to a fresh count on a different hash
  // (real progress) or when a human moves the card out of Blocked. Set to
  // `null` for unlimited — the card is never auto-blocked on repeated
  // failures, no matter how many times the identical root cause recurs.
  "rebuild_cap": 2,

  // When the count of Blocked cards exceeds this percent of the initial Ready
  // count, send a mid-run breakdown notification. Default `30`. Set to `0`
  // to disable.
  "block_rate_alert_pct": 30,

  "notifications": {
    // Auto-detected during onboard; can be overridden.
    "channel": "telegram",
    "chat_id": "auto",

    // The assignee identity used as the claim mutex. Read by
    // `super-board status` and `super-board run`. Recorded during onboard
    // step 11 as either `super-board-bot[bot]` (when a GitHub App is
    // installed on the repo) or the user's own GitHub login (solo projects).
    // Pick during step 2 based on what `gh auth status` returned.
    "bot_identity": "auto"
  }
}
